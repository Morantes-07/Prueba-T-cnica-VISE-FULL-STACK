# data base
DB_HOST=localhost
DB_PORT=puerto de la base de datos a conectarse con docker (ej: 5432, el estándar para postgre en docker es 5432)
DB_USER=usuario de la base de datos (ej:user)
DB_PASSWORD=contraseña base de datos (ej:123456)
DB_NAME=nombre de la base de datos: inventory_db

# Auth
JWT_SECRET=cambiar por string largo (ej: d89jh6l6w4vc9k9jold7cn2x3vcnj9kjk9f8azzgbk9umavuykzs54bnza648z)
JWT_EXPIRES_IN=tiempo de expiración del token (ej:1h)

# Seed user
SEED_USER_EMAIL=email de usuario semilla (ej:admin@example.com)
SEED_USER_PASSWORD=contraseña de usuario semilla (ej:admin123)

# Web - Se incluyen de manera simbólica, pero están definidos por defecto en el proyecto. Puede cambiarlos manualmente en el proyecto si desea
PORT=3000 (Permite conexión entre el backend y docker)
CORS_ORIGIN=http://localhost:5173 (Permite que el backend reciba peticiones del frontend)